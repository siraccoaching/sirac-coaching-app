# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Optionnel : notifications push (https://vapidkeys.com)
VITE_VAPID_PUBLIC_KEY=

# Côté serveur uniquement (Vercel > Environment Variables), pour /api/create-client
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Plan repas IA (/api/meal-plan) : clé API Claude, à mettre uniquement dans les variables d'environnement Vercel
ANTHROPIC_API_KEY=

# Notifications app fermée (Web Push) : clé privée VAPID, uniquement dans Vercel
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://sirac-coaching-app.vercel.app
# Rappel du matin (cron Vercel) : Vercel envoie ce secret automatiquement
CRON_SECRET=
